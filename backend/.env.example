# 복사해서 .env 로 사용하세요. 실제 값은 절대 커밋하지 마세요.

# development | production  (Vercel 배포는 지정하지 않아도 production 으로 동작)
APP_ENV=development

# 로컬: docker compose up -d 로 띄운 Postgres / 배포: Neon 연결 문자열
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pgm

# 세션 토큰 서명 키 (운영 필수). 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 프론트엔드 주소 (쉼표로 여러 개)
ALLOWED_ORIGINS=http://localhost:3000

# 운영 최초 관리자 (선택). 관리자가 한 명도 없을 때 한 번만 만들어집니다.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=관리자
