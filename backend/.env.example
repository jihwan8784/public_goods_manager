# 복사해서 .env 로 사용하세요. 실제 값은 절대 커밋하지 마세요.

# development | production  (Vercel 배포는 지정하지 않아도 production 으로 동작)
APP_ENV=development

# 로컬: docker compose up -d 로 띄운 Postgres / 배포: Neon 연결 문자열
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pgm

# 세션 토큰 서명 키 (운영 필수). 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 프론트엔드 주소 (쉼표로 여러 개)
ALLOWED_ORIGINS=http://localhost:3000

# 운영 최초 관리자 (선택). 관리자가 한 명도 없을 때 한 번만 만들어집니다.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=관리자

# ---- 공공데이터 / 지도 (모두 무료 키) ----
# 교육청 NEIS 학교기본정보 API 키: https://open.neis.go.kr 회원가입 → 인증키 신청
NEIS_API_KEY=
# (선택) 카카오 REST API 키 (주소 → 좌표 변환, 서버 전용). 없으면 관리자 화면에서 위치 CSV 로 좌표 채우기
KAKAO_REST_API_KEY=
# Vercel Cron 인증용 임의 문자열 (Vercel 이 자동으로 Authorization 헤더에 넣어 호출)
CRON_SECRET=

# ---- 메일 (이메일 인증·비밀번호 찾기) — Gmail ----
# 보내는 Gmail 주소
SMTP_USER=
# 구글 계정 → 보안 → 2단계 인증 켜기 → '앱 비밀번호'에서 만든 16자리 (띄어쓰기 상관없음)
SMTP_PASSWORD=
# (선택) 보내는 사람 표시. 비우면 "public goods manage <SMTP_USER>"
MAIL_FROM=
# 메일 속 링크가 열 사이트 주소 (웹 프로젝트 주소, 끝에 / 없이)
APP_BASE_URL=http://localhost:3000
