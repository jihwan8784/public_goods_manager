# 복사해서 .env.local 로 사용하세요.
# API 서버 주소 (서버에서만 사용, 브라우저에는 노출되지 않음)
API_URL=http://127.0.0.1:8000
# QR 코드에 넣을 사이트 주소 (비우면 현재 접속 주소 사용)
NEXT_PUBLIC_SITE_URL=
# 로그인 화면에 개발용 테스트 계정 안내 표시 (개발 환경에서만 1)
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=1
# 카카오맵 JavaScript 키 (공개용 키, 카카오 콘솔에 사이트 도메인 등록 필요). 비우면 지도 대신 목록 표시
NEXT_PUBLIC_KAKAO_MAP_KEY=
